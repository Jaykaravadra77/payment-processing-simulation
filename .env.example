NODE_ENV=development
PORT=3000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=payment_db
DB_USER=root
DB_PASSWORD=secret

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Gateway simulator behaviour (probabilities 0–1, must sum ≤ 1; remainder = timeout)
GATEWAY_SUCCESS_PROB=0.6
GATEWAY_FAILURE_PROB=0.2
GATEWAY_DELAY_PROB=0.1
GATEWAY_TIMEOUT_MS=3000

# Retry & reconciliation
MAX_PAYMENT_ATTEMPTS=3
RETRY_BACKOFF_DELAY_MS=5000
STALE_PROCESSING_MS=60000
RECONCILE_INTERVAL_MS=30000
